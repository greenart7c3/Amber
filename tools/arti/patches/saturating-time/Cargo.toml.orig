[package]
name = "saturating-time"
version = "0.5.0"
authors = ["The Tor Project, Inc.", "Clara Engler <cve@torproject.org>"]
edition = "2024"
rust-version = "1.92"
description = "A trait for limits and saturations on types inside std::time"
repository = "https://gitlab.torproject.org/tpo/core/arti.git"
license = "MIT OR Apache-2.0"
keywords = ["time", "system-time", "instant", "saturating"]
categories = ["date-and-time", "os", "rust-patterns"]

[dependencies]
web-time-compat = { version = "0.3.0", path = "../web-time-compat" }

[features]
full = ["web-time-compat/full"]

[package.metadata.docs.rs]
all-features = true
