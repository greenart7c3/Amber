<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher label (android:label="@string/app_name", set per build type by resValue in
     build.gradle.kts) must be an Android resource. Every other string is a Compose
     resource in :commonsui, shared with the desktop app. -->
<resources xmlns:tools="http://schemas.android.com/tools">
    <string name="app_name_release" translatable="false">Amber</string>
    <!-- Referenced indirectly through resValue("string", "app_name", ...) in build.gradle.kts -->
    <string name="app_name_debug" translatable="false" tools:ignore="UnusedResources">Amber Debug</string>
    <string name="app_name_benchmark" translatable="false" tools:ignore="UnusedResources">Amber Benchmark</string>
</resources>
